PORT=4000
STORE_NAME=Tienda Demo · roo
STORE_URL=http://localhost:4000/demo-shop.html

# Conector SQL Server Opcional (Modo Zero-DDL · solo DML de transición LEAD -> PAYER)
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

# Asesor Comercial SLA (> 10 min)
ADVISOR_NAME=Asesor Comercial Roo
ADVISOR_PHONE=+51 900 000 000
ADVISOR_EMAIL=asesor@roo-soluciones.pe

# Correo Real (Gmail SMTP con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Gemini Opcional (Motor NLU 100% determinista activo incluso sin API key)
GEMINI_API_KEY=

# Umbrales de Reglas de Permanencia (en segundos)
RULE_EMAIL_MAX_SECONDS=300
RULE_WHATSAPP_MAX_SECONDS=600
SESSION_ABANDON_TIMEOUT_SECONDS=25
TOUCH2_DELAY_SECONDS=180
MAX_DISCOUNT_PERCENT=5
COOLDOWN_MINUTES=10

# Contactos iniciales locales opcionales (JSON array; mantener datos reales solo en .env local)
# SEED_LEADS_JSON=
